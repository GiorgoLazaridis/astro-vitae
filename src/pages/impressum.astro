---
import LegalPage from '../components/legal/LegalPage.astro';
import ImpressumContent from '../components/legal/ImpressumContent.astro';
import { cvData } from '../data/cv-data';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isGerman = lang === 'de';
---
<LegalPage
  title={`${t('legal.imprint')} — ${cvData.personal.name}`}
  description={isGerman ? 'Impressum und rechtliche Angaben gemäß § 5 DDG.' : 'Legal information according to § 5 DDG.'}
  heading={t('legal.imprint')}
  lang={lang}
>
  <ImpressumContent isGerman={isGerman} />
</LegalPage>
