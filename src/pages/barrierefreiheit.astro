---
import LegalPage from '../components/legal/LegalPage.astro';
import BarrierefreiheitContent from '../components/legal/BarrierefreiheitContent.astro';
import { cvData } from '../data/cv-data';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isGerman = lang === 'de';
---
<LegalPage
  title={`${t('legal.accessibility')} — ${cvData.personal.name}`}
  description={isGerman ? 'Barrierefreiheitserklärung nach BFSG.' : 'Accessibility statement according to BFSG.'}
  heading={t('legal.accessibility')}
  lang={lang}
>
  <BarrierefreiheitContent isGerman={isGerman} />
</LegalPage>
