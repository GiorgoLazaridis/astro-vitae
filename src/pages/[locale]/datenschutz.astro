---
import LegalPage from '../../components/legal/LegalPage.astro';
import DatenschutzContent from '../../components/legal/DatenschutzContent.astro';
import { cvData } from '../../data/cv-data';
import { getStaticLocalePaths } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

export const getStaticPaths = getStaticLocalePaths;

const lang = (Astro.params.locale as Locale) || 'en';
const t = useTranslations(lang);
const isGerman = lang === 'de';
---
<LegalPage
  title={`${t('legal.privacy')} — ${cvData.personal.name}`}
  description={isGerman ? 'Datenschutzerklärung gemäß DSGVO.' : 'Privacy policy in accordance with GDPR.'}
  heading={t('legal.privacy')}
  lang={lang}
>
  <DatenschutzContent isGerman={isGerman} />
</LegalPage>
